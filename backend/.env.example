# SplitMate API configuration
# Copy to .env and adjust for local development.

APP_ENV=development
PORT=8080
DATABASE_URL=postgres://splitmate:splitmate@localhost:5433/splitmate?sslmode=disable

# Session signing secret. Generate with: openssl rand -base64 32
JWT_SECRET=dev-only-secret-change-me

# Google Sign In (OAuth 2.0). Create a Web application OAuth client at
# https://console.cloud.google.com/apis/credentials and register the redirect URIs.
# The callback must go through the frontend origin (Next.js rewrites proxy
# /api/v1/* to this API), so the session cookie lands on the frontend domain.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:3000/api/v1/auth/google/callback
APP_BASE_URL=http://localhost:3000
