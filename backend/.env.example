# SplitMate API configuration
# Copy to .env and adjust for local development.

APP_ENV=development
PORT=8080
DATABASE_URL=postgres://splitmate:splitmate@localhost:5433/splitmate?sslmode=disable

# Session signing secret. Generate with: openssl rand -base64 32
JWT_SECRET=dev-only-secret-change-me

# Reserved for Milestone 2 (authentication, optional)
COOKIE_DOMAIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
